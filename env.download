NODE_ENV=development

# Note: JWT_SECRET is backend-only, not needed in frontend
NEXT_PUBLIC_BASE_PATH=

# API URLs - Client-side (browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:7777/api/v1
NEXT_PUBLIC_API_URL=http://localhost:7777/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:7777

# NADINE Track Configuration
NEXT_PUBLIC_NADINE=http://localhost:7777/api/v1/track-nadine/disposisi?limit=100&offset=0&search=
NEXT_PUBLIC_NADINE_KONSEP=http://localhost:7777/api/v1/track-nadine/keluar?limit=100&offset=0&general=
NEXT_PUBLIC_NADINE_DETAIL=http://localhost:7777/api/v1/track-nadine/detail
NEXT_PUBLIC_NADINE_UPDATE_TOKEN=http://localhost:7777/api/v1/track-nadine/update-token

# Server-side API URL (for Next.js API routes - direct localhost)
BACKEND_URL=http://localhost:7777/api/v1
API_URL=http://localhost:7777/api/v1

# Backend Port
BACKEND_PORT=7777
NEXT_PUBLIC_BACKEND_PORT=7777

# Socket.IO Configuration
NEXT_PUBLIC_SOCKET_PATH=/socket.io


# Auth Cookie Configuration
NEXT_PUBLIC_AUTH_COOKIE_NAMES=accessToken,access_token,authToken,auth_token,token
NEXT_PUBLIC_SOCKET_TOKEN_COOKIE=accessToken

# Google Maps API - RESTRICT THIS KEY IN GOOGLE CLOUD CONSOLE!
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBbqlde9ZqqlaqvZZYqEPFe7DPqYUq4PFs
GOOGLE_MAPS_API_KEY=AIzaSyBbqlde9ZqqlaqvZZYqEPFe7DPqYUq4PFs

# Debug Settings (disabled in production)
NEXT_MW_PROBE=0
NEXT_PUBLIC_DEBUG_AUTH=true

# WhatsApp Messaging Feature Flags
NEXT_PUBLIC_ENABLE_WHATSAPP_MESSAGING=true
NEXT_PUBLIC_WHATSAPP_MESSAGING_ROLLOUT_PERCENT=100
NEXT_PUBLIC_TEST_USERS=c961b27c-24cc-4e66-a295-aa7fec2b430b

# Socket/WS URL
NEXT_PUBLIC_LOCAL_SOCKET_DANADESA=ws://localhost:7777

# Dispensasi endpoints
NEXT_PUBLIC_SIMPANDISPENSASI=http://localhost:7777/api/v1/dispensasi/simpan-dispensasi
NEXT_PUBLIC_SIMPANKONTRAK=http://localhost:7777/api/v1/dispensasi/simpan-kontrak
NEXT_PUBLIC_SIMPANTUP=http://localhost:7777/api/v1/dispensasi/simpan-tup

# Harmonisasi
NEXT_PUBLIC_TAYANG_HARMONISASI=http://localhost:7777/api/v1/harmonisasi/view?queryParams=
NEXT_PUBLIC_HARMONISASI=http://localhost:7777/api/v1/harmonisasi/simpan

# Blokir Perjadin
NEXT_PUBLIC_API_BLOKIR_MONITORING=http://localhost:7777/api/v1/blokir/monitoring
NEXT_PUBLIC_API_BLOKIR_SATKER=http://localhost:7777/api/v1/blokir/monitoring-satker
NEXT_PUBLIC_API_BLOKIR_UPDATE_DISPEN=http://localhost:8080/api/v1/blokir/update-dispen

# Monev PNBP
NEXT_PUBLIC_TAYANGMONEVPNBP=http://localhost:7777/api/v1/monev-pnbp/tayang
NEXT_PUBLIC_LOCAL_SIMPANMONEVPNBP=http://localhost:7777/api/v1/monev-pnbp/update
NEXT_PUBLIC_LOCAL_UPDATE_LAPPNBP=http://localhost:7777/api/v1/monev-pnbp/update-laporan
NEXT_PUBLIC_LOCAL_GET_REKAMAN=http://localhost:7777/api/v1/monev-pnbp/rekaman
NEXT_PUBLIC_GET_REKAMAN_NOTADINAS=http://localhost:7777/api/v1/monev-pnbp/rekaman-nd
